# Copy to .env for local runs. On GitHub Actions, set these as repository Secrets.
GMAIL_USER=developer.work.david@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
ALERT_TO=developer.work.david@gmail.com

# Minimum keyword hits (title/company/tags). Default 2.
MIN_SCORE=2
# Max links per email
MAX_ALERT=40

# 1 = mark matches as seen without emailing (first-run seed)
# Leave unset on Actions after the first successful seed run
SEED=0
